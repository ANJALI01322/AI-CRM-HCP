# Copy to frontend/.env.local for local development.
# Vite only exposes variables prefixed with VITE_ to the browser: never put secrets here.

# API base URL. Leave empty to use same-origin "/api" (Vercel rewrites / the Vite dev proxy).
# If set, it must include the /api prefix and the backend's ALLOWED_ORIGINS must list this site.
# Example: https://your-backend.example.com/api
VITE_API_URL=

# Dev only: where `npm run dev` proxies /api (default: http://localhost:8000)
VITE_DEV_API_TARGET=http://localhost:8000
