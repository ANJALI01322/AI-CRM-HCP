# Copy to backend/.env for local development. On Vercel, set these in Project Settings → Environment Variables.

# Required: Postgres connection string (Neon: use the pooled URL with sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required for AI features
GROQ_API_KEY=

# Optional: Groq model (default: openai/gpt-oss-120b)
MODEL_NAME=

# Optional: comma-separated origins allowed by CORS (default: http://localhost:5173)
ALLOWED_ORIGINS=

# Required for login: long random secret used to sign JWTs (24h expiry).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: slug of the demo organization created by `python seed.py` (default: demo)
DEMO_ORG_SLUG=
