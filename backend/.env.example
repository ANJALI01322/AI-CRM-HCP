# Copy to backend/.env for local development (never commit .env).
# On Vercel, set these under Project Settings -> Environment Variables.

# --- Required -----------------------------------------------------------------

# Postgres connection string (Neon: use the pooled connection string, sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Groq API key for the AI features (extraction and the AI Analyst)
GROQ_API_KEY=

# Secret used to sign login tokens (JWT, 24h). Must be at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Recommended --------------------------------------------------------------

# Groq model (default: openai/gpt-oss-120b)
MODEL_NAME=openai/gpt-oss-120b

# Comma-separated browser origins allowed by CORS, no trailing slash.
# Same-origin deployments (frontend and API on one Vercel domain) don't need this.
# Example: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Optional -----------------------------------------------------------------

# Log verbosity: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Slug of the demo organization created by `python seed.py` (default: demo)
DEMO_ORG_SLUG=demo
